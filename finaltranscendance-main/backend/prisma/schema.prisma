generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  activityLogs  ActivityLog[]
  channels      Channel[]
  interventions Intervention[]
  users         User[]
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  passwordHash          String
  fullName              String
  phone                 String?
  role                  Role                 @default(TECHNICIAN)
  status                UserStatus           @default(ACTIVE)
  organizationId        String?
  avatarUrl             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  satisfactionToken     String?              @unique
  satisfactionSubmitted Boolean              @default(false)
  activityLogs          ActivityLog[]
  channelMembers        ChannelMember[]
  interventions         Intervention[]       @relation("TechnicianInterventions")
  messages              Message[]
  reports               InterventionReport[]
  organization          Organization?        @relation(fields: [organizationId], references: [id])
  friendshipsSent       Friendship[]         @relation("FriendshipRequester")
  friendshipsReceived   Friendship[]         @relation("FriendshipReceiver")
  notifications         Notification[]
}

model Notification {
  id           String   @id @default(uuid())
  userId       String
  type         String
  title        String
  message      String
  read         Boolean  @default(false)
  friendshipId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendship Friendship? @relation(fields: [friendshipId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester     User           @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver      User           @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Intervention {
  id                    String               @id @default(uuid())
  organizationId        String
  clientName            String
  clientAddress         String
  fibreSocket           String
  description           String
  priority              InterventionPriority @default(MEDIUM)
  status                InterventionStatus   @default(ASSIGNED)
  technicianId          String?
  scheduledAt           DateTime
  report                String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  satisfactionToken     String?              @unique
  satisfactionSubmitted Boolean              @default(false)
  activityLogs          ActivityLog[]
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technician            User?                @relation("TechnicianInterventions", fields: [technicianId], references: [id])
  reports               InterventionReport[]
  satisfaction          SatisfactionRating?
}

model InterventionReport {
  id             String   @id @default(uuid())
  interventionId String
  technicianId   String
  content        String
  actionTaken    String?
  createdAt      DateTime @default(now())

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  technician   User         @relation(fields: [technicianId], references: [id])

  @@index([interventionId])
  @@index([technicianId])
}

model SatisfactionRating {
  id             String   @id @default(uuid())
  interventionId String   @unique
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id             String        @id @default(uuid())
  organizationId String
  interventionId String?
  technicianId   String?
  action         String
  detail         String?
  createdAt      DateTime      @default(now())
  intervention   Intervention? @relation(fields: [interventionId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technician     User?         @relation(fields: [technicianId], references: [id])

  @@index([organizationId])
  @@index([interventionId])
  @@index([technicianId])
}

model Channel {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  type           ChannelType     @default(GROUP)
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ChannelMember[]
  messages       Message[]

  @@index([organizationId])
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(uuid())
  channelId String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InterventionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InterventionStatus {
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ChannelType {
  DM
  GROUP
}
