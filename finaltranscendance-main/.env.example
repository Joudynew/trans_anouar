# CLAUDE-MODIF (2026-10-07) — NOUVEAU fichier : modèle des variables d'environnement (exigé par le sujet).
# Copier ce fichier en .env :  cp .env.example .env
# (`make` le fait automatiquement et génère un JWT_SECRET aléatoire.)

# --- Base de données PostgreSQL ---
POSTGRES_USER=fibreflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fibreflow

# --- Backend ---
# Secret de signature des JWT : 32 caractères minimum.
# Générer avec : openssl rand -hex 32
JWT_SECRET=
# URL publique du site (origine autorisée par CORS)
FRONTEND_URL=https://localhost:8443

# Premier compte SUPER_ADMIN, créé au démarrage s'il n'en existe aucun.
SUPER_ADMIN_EMAIL=admin@fibreflow.local
SUPER_ADMIN_PASSWORD=

# --- Frontend ---
# URL de l'API vue par le navigateur. Relative par défaut (même origine que le site).
VITE_API_URL=/api

# --- Nginx ---
# Ports publiés sur la machine hôte. >= 1024 car Podman/Docker rootless
# (machines 42) ne peut pas utiliser 80/443.
HTTP_PORT=8080
HTTPS_PORT=8443
# Nom d'hôte utilisé pour le certificat auto-signé
SERVER_NAME=localhost
